{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/getState",
      "dest": "/api/getState.js"
    },
    {
      "src": "/api/setState",
      "dest": "/api/setState.js"
    },
    {
      "src": "/.*",
      "dest": "/public/watchlist-dashboard.html"
    }
  ]
}
